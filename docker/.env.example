# Synthetic dev-only values. Copy to docker/.env (git/docker-ignored). Never reuse real secrets.
POSTGRES_PASSWORD=pg_admin_synthetic_pw
TSESSION_DB_PASSWORD=tsession_synthetic_pw
REDIS_PASSWORD=redis_synthetic_pw
# Delete recorded sessions this long after they were sealed (Go duration). Unset or 0 keeps them forever.
#TSESSION_COLLECTOR_RETENTION=168h
# Compose network subnet; the collector only accepts /v1/internal/* from inside it.
#TSESSION_NET_SUBNET=172.29.213.0/24
