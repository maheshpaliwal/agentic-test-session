# syntax=docker/dockerfile:1
# Build context: repo root (needs go.work + every module's go.mod).
#   docker build -f docker/Dockerfile.exampleapp .
FROM golang:1.26-alpine AS build
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    cd integration && GOWORK=off GOFLAGS="-trimpath -mod=mod" go build -ldflags="-s -w" -o /out/exampleapp ./cmd/exampleapp

FROM alpine:3.21
RUN addgroup -S -g 10001 ts && adduser -S -u 10001 -G ts ts && mkdir -p /data/bundles && chown -R ts:ts /data
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --from=build /out/exampleapp /usr/local/bin/exampleapp
USER ts
WORKDIR /data
ENV TSESSION_BIN=exampleapp
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
