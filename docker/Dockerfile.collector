# syntax=docker/dockerfile:1
# Build context: repo root (needs go.work + every module's go.mod).
#   docker build -f docker/Dockerfile.collector .
FROM golang:1.26-alpine AS build
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
# The build context has no .git, so the version is passed in (see the Makefile); empty leaves "(devel)".
# It is quoted inside -ldflags so that a value with a space cannot add linker flags.
ARG VERSION=
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -ldflags="-s -w -X 'github.com/maheshpaliwal/agentic-test-session/internal/svc.buildVersion=${VERSION}'" -o /out/collector ./collector/cmd/collector

FROM alpine:3.21
RUN addgroup -S -g 10001 ts && adduser -S -u 10001 -G ts ts && mkdir -p /data/bundles && chown -R ts:ts /data
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --from=build /out/collector /usr/local/bin/collector
USER ts
WORKDIR /data
ENV TSESSION_BIN=collector
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
